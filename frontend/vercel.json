{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RENDER_API_HOST.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://REPLACE_WITH_RENDER_API_HOST.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://REPLACE_WITH_RENDER_API_HOST.onrender.com/sitemap.xml"
    }
  ]
}
